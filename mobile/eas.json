{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://192.168.1.10:3000" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-YOUR-SERVER" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-YOUR-SERVER" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "REPLACE-WITH-APP-STORE-CONNECT-APP-ID" },
      "android": { "track": "internal", "serviceAccountKeyPath": "./play-service-account.json" }
    }
  }
}
