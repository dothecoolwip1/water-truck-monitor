# Postgres connection string. Supabase, Neon, Render or any Postgres 14+ works.
# Add ?sslmode=require for hosted databases.
DATABASE_URL=postgres://postgres@localhost:5432/watertruck
# Long random string used to sign sign-in tokens. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
# Day boundaries for reports and "today's jobs".
APP_TIMEZONE=America/Edmonton
# Shown on delivery tickets.
ORG_NAME=Water Delivery
PORT=3000
# Used once by `npm run seed` to create the first admin account.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Set to false to stop sending new-job alerts to phones.
PUSH_ENABLED=true
